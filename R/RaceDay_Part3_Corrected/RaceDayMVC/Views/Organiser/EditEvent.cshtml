@model RaceEvent
@{ ViewData["Title"] = Model.EventId == 0 ? "Create event" : "Edit event"; }
<h1>@(Model.EventId == 0 ? "Create event" : "Edit event")</h1>
<form method="post" enctype="multipart/form-data" class="form-panel">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input asp-for="EventId" type="hidden" />
    <input asp-for="EventImageUrl" type="hidden" />

    <label asp-for="EventName">Event name</label>
    <input asp-for="EventName" required maxlength="150" class="form-control mb-1" />
    <span asp-validation-for="EventName" class="field-error"></span>

    <label asp-for="Description" class="mt-2">Description</label>
    <textarea asp-for="Description" rows="4" class="form-control mb-2"></textarea>

    <label asp-for="EventDate" class="mt-2">Date</label>
    <input asp-for="EventDate" type="date" asp-format="{0:yyyy-MM-dd}" required class="form-control mb-1" />
    <span asp-validation-for="EventDate" class="field-error"></span>

    <label asp-for="Location" class="mt-2">Location</label>
    <input asp-for="Location" required class="form-control mb-1" />
    <span asp-validation-for="Location" class="field-error"></span>

    <label asp-for="DistanceKm" class="mt-2">Distance (km)</label>
    <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" max="1000" required class="form-control mb-1" />
    <span asp-validation-for="DistanceKm" class="field-error"></span>

    <label asp-for="EventType" class="mt-2">Event type</label>
    <select asp-for="EventType" class="form-select mb-1">
        <option value="Road">Road</option>
        <option value="Trail">Trail</option>
        <option value="Track">Track</option>
    </select>
    <span asp-validation-for="EventType" class="field-error"></span>

    @if (!string.IsNullOrWhiteSpace(Model.EventImageUrl))
    {
        <div class="my-3">
            <img src="@Model.EventImageUrl" alt="Current banner" class="detail-banner" />
            <div class="form-text">Current banner. Choose a new file to replace it.</div>
        </div>
    }
    <label for="banner" class="mt-2">Banner image (JPG, PNG or WebP, max 5 MB)</label>
    <input id="banner" type="file" name="banner" accept="image/jpeg,image/png,image/webp" class="form-control mb-3" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-brand">Save event</button>
        <a class="btn btn-outline-night" asp-action="Events">Cancel</a>
    </div>
</form>
