@{
    var role = Context.Session.GetString("Role");
    var signedIn = Context.Session.GetString("ApiToken") != null;
    var ctl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string c, params string[] a) => ctl == c && (a.Length == 0 || a.Contains(act)) ? "active" : "";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>RaceDay | @ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" asp-append-version="true" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark rd-nav">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Race<span>Day</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div id="nav" class="collapse navbar-collapse">
                <div class="navbar-nav me-auto">
                    @if (role == "Organiser")
                    {
                        <a class="nav-link @Active("Organiser", "Dashboard")" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a>
                        <a class="nav-link @Active("Organiser", "Events", "EditEvent", "Categories", "Enrolments", "Results")" asp-controller="Organiser" asp-action="Events">Events</a>
                    }
                    else
                    {
                        <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Find races</a>
                        @if (role == "Participant")
                        {
                            <a class="nav-link @Active("Participant", "MyEvents")" asp-controller="Participant" asp-action="MyEvents">My events</a>
                            <a class="nav-link @Active("Participant", "MyResults")" asp-controller="Participant" asp-action="MyResults">My results</a>
                            <a class="nav-link @Active("Participant", "Profile")" asp-controller="Participant" asp-action="Profile">Profile</a>
                        }
                    }
                </div>
                <div class="d-flex align-items-center">
                    @if (signedIn)
                    {
                        <span class="role-tag">@role</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-light">Log out</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light me-2" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-bib" asp-controller="Account" asp-action="Register">Join RaceDay</a>
                    }
                </div>
            </div>
        </div>
    </nav>
    <main class="container py-4">
        @if (TempData["Notice"] is string notice)
        {
            <div class="alert alert-success" role="status">@notice</div>
        }
        @if (TempData["Error"] is string problem)
        {
            <div class="alert alert-danger" role="alert">@problem</div>
        }
        @RenderBody()
    </main>
    <footer class="container-fluid rd-footer">
        <div class="container"><strong>RaceDay</strong> Run your race.</div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
