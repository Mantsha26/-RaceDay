@model CategoriesPage
@{
    ViewData["Title"] = "Categories";
    var editing = Model.Form.CategoryId != 0;
}
<p class="mb-1"><a asp-action="Events">Back to events</a></p>
<h1>Categories for @Model.Event.EventName</h1>

@if (Model.Categories.Count == 0)
{
    <div class="empty-state mb-4"><p>No categories yet. Add an age group or a distance below so participants can enrol.</p></div>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table align-middle">
            <thead><tr><th>Name</th><th>Description</th><th>Ages</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@c.Description</td>
                        <td>@c.MinAge to @c.MaxAge</td>
                        <td>
                            <div class="row-actions">
                                <a asp-action="Categories" asp-route-id="@Model.Event.EventId" asp-route-editId="@c.CategoryId">Edit</a>
                                <form method="post" asp-action="DeleteCategory" data-confirm="Delete this category?">
                                    <input type="hidden" name="id" value="@c.CategoryId" />
                                    <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h4">@(editing ? "Edit category" : "Add a category")</h2>
<form method="post" asp-action="SaveCategory" class="form-panel">
    <input type="hidden" name="EventId" value="@Model.Event.EventId" />
    <input type="hidden" name="CategoryId" value="@Model.Form.CategoryId" />
    <label for="catName">Name</label>
    <input id="catName" name="Name" value="@Model.Form.Name" required maxlength="50" list="catNames" class="form-control mb-2" />
    <datalist id="catNames">
        <option value="Under 18"></option><option value="18 to 34"></option><option value="35 to 49"></option><option value="50 and over"></option>
        <option value="5 km"></option><option value="10 km"></option><option value="Half marathon"></option><option value="Marathon"></option>
    </datalist>
    <label for="catDesc">Description</label>
    <input id="catDesc" name="Description" value="@Model.Form.Description" maxlength="255" class="form-control mb-2" />
    <div class="row g-2">
        <div class="col-6">
            <label for="minAge">Minimum age</label>
            <input id="minAge" name="MinAge" type="number" min="0" max="120" value="@Model.Form.MinAge" class="form-control" />
        </div>
        <div class="col-6">
            <label for="maxAge">Maximum age</label>
            <input id="maxAge" name="MaxAge" type="number" min="0" max="120" value="@Model.Form.MaxAge" class="form-control" />
        </div>
    </div>
    <div class="form-text mb-3">For a distance category such as 10 km, leave the ages at 0 to 99. Participants outside the age range can't enrol.</div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-brand">@(editing ? "Save changes" : "Add category")</button>
        @if (editing) { <a class="btn btn-outline-night" asp-action="Categories" asp-route-id="@Model.Event.EventId">Cancel</a> }
    </div>
</form>
