@model List<RaceEnrolment>
@{ ViewData["Title"] = "My results"; }
<h1>My results</h1>
@if (Model.Count == 0)
{
    <div class="empty-state"><p>No results yet. Organisers publish results after each race finishes.</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.EventName</td>
                        <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@e.CategoryName</td>
                        <td>@RaceFormat.Time(e.TimeSeconds)</td>
                        <td>@RaceFormat.Ordinal(e.Position ?? 0) out of @e.Finishers finishers</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
