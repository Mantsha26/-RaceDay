@model List<RaceEvent>
@{
    ViewData["Title"] = "Organiser dashboard";
    var upcoming = Model.Where(e => e.EventDate.Date >= DateTime.Today).OrderBy(e => e.EventDate).ToList();
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Organiser dashboard</h1>
    <a class="btn btn-brand" asp-action="EditEvent">Create event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="stat"><strong>@Model.Count</strong><p>Events created</p></div></div>
    <div class="col-md-4"><div class="stat"><strong>@Model.Sum(e => e.EnrolmentCount)</strong><p>Total enrolments</p></div></div>
    <div class="col-md-4"><div class="stat"><strong>@upcoming.Count</strong><p>Upcoming events</p></div></div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <p>You haven't created an event yet.</p>
        <a class="btn btn-brand" asp-action="EditEvent">Create your first event</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="panel">
                <h2 class="h4">Coming up</h2>
                @if (upcoming.Count == 0)
                {
                    <p class="text-muted mb-0">No upcoming events.</p>
                }
                else
                {
                    <ul class="next-list">
                        @foreach (var e in upcoming.Take(5))
                        {
                            <li><span class="next-date">@e.EventDate.ToString("dd MMM yyyy")</span><span>@e.EventName</span></li>
                        }
                    </ul>
                }
            </div>
        </div>
        <div class="col-lg-8">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Event</th><th>Date</th><th>Enrolments</th><th>Manage</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model.OrderBy(e => e.EventDate))
                        {
                            <tr>
                                <td>@e.EventName</td>
                                <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@e.EnrolmentCount</td>
                                <td>
                                    <div class="row-actions">
                                        <a asp-action="Categories" asp-route-id="@e.EventId">Categories</a>
                                        <a asp-action="Enrolments" asp-route-id="@e.EventId">Enrolments</a>
                                        <a asp-action="Results" asp-route-id="@e.EventId">Results</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
