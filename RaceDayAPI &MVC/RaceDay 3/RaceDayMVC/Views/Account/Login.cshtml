@model LoginForm
@{ ViewData["Title"] = "Log in"; }
<div class="form-panel">
    <h1>Welcome back</h1>
    <form method="post" asp-action="Login">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" class="form-control mb-1" autocomplete="email" />
        <span asp-validation-for="Email" class="field-error"></span>
        <label asp-for="Password" class="mt-2">Password</label>
        <input asp-for="Password" type="password" class="form-control mb-1" autocomplete="current-password" />
        <span asp-validation-for="Password" class="field-error"></span>
        <button type="submit" class="btn btn-brand w-100 mt-3">Log in</button>
    </form>
    <p class="mt-3 mb-0">New to RaceDay? <a asp-action="Register">Create an account</a></p>
</div>
