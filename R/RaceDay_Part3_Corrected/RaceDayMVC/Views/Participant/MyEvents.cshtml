@model List<RaceEnrolment>
@{ ViewData["Title"] = "My events"; }
<h1>My events</h1>
@if (Model.Count == 0)
{
    <div class="empty-state">
        <p>You haven't enrolled in a race yet.</p>
        <a class="btn btn-brand" asp-controller="Home" asp-action="Index">Find a race</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Race</th><th>Date</th><th>Category</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><a asp-controller="Home" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td>
                        <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@e.CategoryName</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
